# Copy to .env and set your real values. .env is gitignored (keeps site-specific
# addresses out of the public repo); docker-compose.dev.yml reads these.
SCANAPP_LDAP_URL=ldap://ldap.example.com:389
SCANAPP_LDAP_USER_BASE=ou=people,dc=example,dc=com
SCANAPP_LDAP_GROUP_BASE=ou=groups,dc=example,dc=com
SCANAPP_ESCL_BASE_URL=http://printer.example.com
